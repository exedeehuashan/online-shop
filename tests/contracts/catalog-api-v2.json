{
  "openapi":"3.1.0",
  "info":{"title":"Online Shop Catalog Public Read API","version":"2.0.0"},
  "paths":{
    "/api/v2/products":{"get":{"operationId":"browseProducts","parameters":[
      {"name":"page","in":"query","schema":{"type":"integer","minimum":0,"default":0}},
      {"name":"size","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},
      {"name":"sort","in":"query","schema":{"type":"string","enum":["updated-desc","name-asc","price-asc","price-desc"],"default":"updated-desc"}},
      {"name":"category","in":"query","schema":{"type":"array","maxItems":50,"items":{"type":"string"}}},
      {"name":"attribute","in":"query","schema":{"type":"array","maxItems":50,"items":{"type":"string","pattern":"^[^:]+:[0-9a-fA-F-]{36}$"}}},
      {"name":"availability","in":"query","schema":{"type":"string","enum":["any","in-stock","out-of-stock"],"default":"any"}},
      {"name":"minPrice","in":"query","schema":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]{1,2})?$"}},
      {"name":"maxPrice","in":"query","schema":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]{1,2})?$"}},
      {"name":"currency","in":"query","schema":{"type":"string","pattern":"^[A-Z]{3}$"}}
    ],"responses":{"200":{"description":"Product page","headers":{"X-Correlation-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductPage"}}}},"400":{"$ref":"#/components/responses/Problem"},"422":{"$ref":"#/components/responses/Problem"},"500":{"$ref":"#/components/responses/Problem"}}}},
    "/api/v2/products/{productId}":{"get":{"operationId":"getProductById","parameters":[{"name":"productId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Product detail","headers":{"X-Correlation-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductDetail"}}}},"400":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"500":{"$ref":"#/components/responses/Problem"}}}},
    "/api/v2/products/by-slug/{slug}":{"get":{"operationId":"getProductBySlug","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","maxLength":180,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}}],"responses":{"200":{"description":"Product detail","headers":{"X-Correlation-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductDetail"},"examples":{"product":{"value":{"id":"00000000-0000-0000-0000-000000000001","slug":"green-tea","name":"Green Tea","description":"Leaves","defaultSkuId":"00000000-0000-0000-0000-000000000002","price":{"amount":"12.30","currency":"NZD"},"priceRange":{"min":{"amount":"12.30","currency":"NZD"},"max":{"amount":"12.30","currency":"NZD"}},"availability":"IN_STOCK","primaryImage":null,"categories":[],"updatedAt":"2026-10-24T00:00:00Z","createdAt":"2026-10-24T00:00:00Z","attributes":[],"variantAxes":[],"skus":[{"id":"00000000-0000-0000-0000-000000000002","sku":"GREEN-TEA","default":true,"price":{"amount":"12.30","currency":"NZD"},"availableQuantity":4,"availability":"IN_STOCK","attributes":[],"imageIds":[]}],"images":[]}}}}}},"400":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"500":{"$ref":"#/components/responses/Problem"}}}}
  },
  "components":{"responses":{"Problem":{"description":"RFC 9457 problem","headers":{"X-Correlation-ID":{"schema":{"type":"string"}}},"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}},"schemas":{
    "Money":{"type":"object","required":["amount","currency"],"properties":{"amount":{"type":"string","pattern":"^[0-9]+\\.[0-9]{2}$"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"}}},
    "Image":{"type":"object","required":["id","url","altText","width","height","displayOrder","primary"],"properties":{"id":{"type":"string","format":"uuid"},"skuId":{"type":["string","null"],"format":"uuid"},"url":{"type":"string"},"altText":{"type":"string"},"width":{"type":"integer","minimum":1,"maximum":32768},"height":{"type":"integer","minimum":1,"maximum":32768},"displayOrder":{"type":"integer","minimum":0},"primary":{"type":"boolean"}}},
    "PriceRange":{"type":"object","required":["min","max"],"properties":{"min":{"$ref":"#/components/schemas/Money"},"max":{"$ref":"#/components/schemas/Money"}}},
    "CategoryRef":{"type":"object","required":["id","slug","name","displayOrder"],"properties":{"id":{"type":"string","format":"uuid"},"slug":{"type":"string"},"name":{"type":"string"},"parentId":{"type":["string","null"],"format":"uuid"},"displayOrder":{"type":"integer"}}},
    "AttributeDefinition":{"type":"object","required":["id","code","name","dataType","scope","variantAxis"],"properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string"},"name":{"type":"string"},"dataType":{"type":"string","enum":["TEXT","INTEGER","DECIMAL","BOOLEAN"]},"scope":{"type":"string","enum":["PRODUCT","SKU","BOTH"]},"variantAxis":{"type":"boolean"}}},
    "AttributeValue":{"type":"object","required":["id","value","displayValue"],"properties":{"id":{"type":"string","format":"uuid"},"value":{},"displayValue":{"type":"string"}}},
    "AttributeSelection":{"type":"object","required":["definition","values"],"properties":{"definition":{"$ref":"#/components/schemas/AttributeDefinition"},"values":{"type":"array","items":{"$ref":"#/components/schemas/AttributeValue"}}}},
    "Sku":{"type":"object","required":["id","sku","default","price","availableQuantity","availability","attributes","imageIds"],"properties":{"id":{"type":"string","format":"uuid"},"sku":{"type":"string"},"default":{"type":"boolean"},"price":{"$ref":"#/components/schemas/Money"},"availableQuantity":{"type":"integer","minimum":0},"availability":{"type":"string","enum":["IN_STOCK","OUT_OF_STOCK"]},"attributes":{"type":"array","items":{"$ref":"#/components/schemas/AttributeSelection"}},"imageIds":{"type":"array","items":{"type":"string","format":"uuid"}}}},
    "VariantOption":{"type":"object","required":["id","value","displayValue","availability"],"properties":{"id":{"type":"string","format":"uuid"},"value":{},"displayValue":{"type":"string"},"availability":{"type":"string","enum":["IN_STOCK","OUT_OF_STOCK"]}}},
    "VariantAxis":{"type":"object","required":["definition","options"],"properties":{"definition":{"$ref":"#/components/schemas/AttributeDefinition"},"options":{"type":"array","items":{"$ref":"#/components/schemas/VariantOption"}}}},
    "FacetBucket":{"type":"object","required":["id","value","selected","count"],"properties":{"id":{"type":"string"},"value":{"type":"string"},"selected":{"type":"boolean"},"count":{"type":"integer","minimum":0}}},
    "AttributeFacet":{"type":"object","required":["code","name","values"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"values":{"type":"array","items":{"$ref":"#/components/schemas/FacetBucket"}}}},
    "PageMetadata":{"type":"object","required":["page","size","numberOfElements","totalElements","totalPages","first","last"],"properties":{"page":{"type":"integer"},"size":{"type":"integer"},"numberOfElements":{"type":"integer"},"totalElements":{"type":"integer"},"totalPages":{"type":"integer"},"first":{"type":"boolean"},"last":{"type":"boolean"}}},
    "Facets":{"type":"object","required":["categories","attributes","availability","truncated"],"properties":{"categories":{"type":"array","items":{"$ref":"#/components/schemas/FacetBucket"}},"attributes":{"type":"array","items":{"$ref":"#/components/schemas/AttributeFacet"}},"availability":{"type":"array","items":{"$ref":"#/components/schemas/FacetBucket"}},"price":{"oneOf":[{"type":"object","required":["min","max","currency"],"properties":{"min":{"type":"string"},"max":{"type":"string"},"currency":{"type":"string"}}},{"type":"null"}]},"truncated":{"type":"boolean"}}},
    "ProductSummary":{"type":"object","required":["id","slug","name","description","defaultSkuId","price","priceRange","availability","categories","updatedAt"],"properties":{"id":{"type":"string","format":"uuid"},"slug":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"defaultSkuId":{"type":"string","format":"uuid"},"price":{"$ref":"#/components/schemas/Money"},"priceRange":{"$ref":"#/components/schemas/PriceRange"},"availability":{"type":"string","enum":["IN_STOCK","OUT_OF_STOCK"]},"primaryImage":{"oneOf":[{"$ref":"#/components/schemas/Image"},{"type":"null"}]},"categories":{"type":"array","items":{"$ref":"#/components/schemas/CategoryRef"}},"updatedAt":{"type":"string","format":"date-time"}}},
    "ProductDetail":{"allOf":[{"$ref":"#/components/schemas/ProductSummary"},{"type":"object","required":["createdAt","attributes","variantAxes","skus","images"],"properties":{"createdAt":{"type":"string","format":"date-time"},"attributes":{"type":"array","items":{"$ref":"#/components/schemas/AttributeSelection"}},"variantAxes":{"type":"array","items":{"$ref":"#/components/schemas/VariantAxis"}},"skus":{"type":"array","items":{"$ref":"#/components/schemas/Sku"}},"images":{"type":"array","items":{"$ref":"#/components/schemas/Image"}}}}]},
    "ProductPage":{"type":"object","required":["items","page","facets"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/ProductSummary"}},"page":{"$ref":"#/components/schemas/PageMetadata"},"facets":{"$ref":"#/components/schemas/Facets"}}},
    "Violation":{"type":"object","required":["field","message"],"properties":{"field":{"type":"string"},"message":{"type":"string"}}},
    "Problem":{"type":"object","required":["type","title","status","detail","instance","code","correlationId","violations"],"properties":{"type":{"type":"string","format":"uri"},"title":{"type":"string"},"status":{"type":"integer"},"detail":{"type":"string"},"instance":{"type":"string"},"code":{"type":"string"},"correlationId":{"type":"string"},"violations":{"type":"array","items":{"$ref":"#/components/schemas/Violation"}}}}
  }}
}
